# Claude session transcripts (can be huge, not useful for backup)
**/.claude/projects/*/[0-9a-f][0-9a-f][0-9a-f][0-9a-f]*[0-9a-f]/

# Tool result caches
**/tool-results/

# Python/node caches
**/__pycache__/
**/node_modules/
**/.venv/

# macOS
.DS_Store

# Large binaries and audio
*.wav
*.mp3
*.mp4
*.mov
*.zip
*.tar.gz

# graphify outputs (regenerable)
**/graphify-out/

# Local secrets (should never be committed)
**/.env
**/*.pem
**/*.key
